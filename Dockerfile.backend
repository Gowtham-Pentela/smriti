# ── Backend API Dockerfile ────────────────────────────────────────────────────
# Multi-stage build: keeps the final image lean by separating build deps.
# The backend image does NOT contain Streamlit or the UI app.

FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements.txt .

# Install build tools for packages that compile native extensions (e.g. asyncpg)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt \
    && apt-get purge -y gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Runtime image ─────────────────────────────────────────────────────────────
FROM python:3.12-slim

# ffmpeg is required by backend/transcription.py (Whisper audio extraction)
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder stage
COPY --from=builder /install /usr/local

# Copy application source
COPY backend/ ./backend/
COPY data/    ./data/

# Required so Python treats backend/ as a package
RUN touch backend/__init__.py 2>/dev/null || true

# Environment defaults (overridden at runtime via K8s env vars or .env mount)
ENV DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres" \
    OLLAMA_EMBED_URL="http://localhost:11434/api/embeddings" \
    OLLAMA_GEN_URL="http://localhost:11434/api/generate" \
    KGF_ENCRYPTION_KEY=""

EXPOSE 8000

# Use exec form so signals (SIGTERM) are delivered directly to uvicorn
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
