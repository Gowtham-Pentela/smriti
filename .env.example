# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running KGF.
# cp .env.example .env
# Never commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: Supabase on port 54322 (run: supabase start)
# Production: use your Cloud SQL or managed Postgres connection string.
DATABASE_URL=postgresql://postgres:your-db-password@127.0.0.1:54322/postgres

# ── Ollama (local inference) ──────────────────────────────────────────────────
# Pull models first:
#   ollama pull nomic-embed-text   # embeddings (274MB)
#   ollama pull tinyllama          # generation (638MB, fits in 8GB RAM)
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
OLLAMA_GEN_URL=http://localhost:11434/api/generate

# Vision model for PDF image/diagram processing (optional).
# Pull with: ollama pull llava:7b
# Lighter alternative: ollama pull moondream
KGF_VISION_MODEL=llava:7b

# ── Fernet encryption key (for tenant OAuth tokens) ──────────────────────────
# Generate a fresh key — do this once per environment, never reuse across envs:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the output (43 chars ending in =) below.
KGF_ENCRYPTION_KEY=your-base64-fernet-key-here

# ── Authentication ────────────────────────────────────────────────────────────
# Set to "true" for local development — skips GCP IAP header validation.
# In production (GCP + IAP), leave this unset or set to "false".
KGF_DEV_MODE=true

# KGF_ENV tells the safety guard what environment this is.
# Allowed values: local, dev, development  (anything else blocks KGF_DEV_MODE=true)
KGF_ENV=local

# When KGF_DEV_MODE=true, this email is used as the logged-in user identity.
# Use your real work email to match the tenant your data was indexed under.
KGF_DEV_USER_EMAIL=you@yourcompany.com

# ── Tenant UUID (single-tenant / demo mode) ──────────────────────────────────
# PROBLEM: auto-provisioning derives a UUID from the email domain. If your
# benchmark data was indexed under a specific tenant schema, queries return
# zero results unless this UUID matches.
#
# FIX: Set this to the UUID where your data actually lives.
#   Find it with: SELECT schema_name FROM information_schema.schemata
#                 WHERE schema_name LIKE 'tenant_%';
# Then strip the "tenant_" prefix — the remainder is your UUID.
#
# For multi-tenant production deployments: REMOVE this variable entirely.
KGF_FORCE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Slack OAuth ───────────────────────────────────────────────────────────────
# Create a Slack app at: https://api.slack.com/apps
# Required bot token scopes: channels:history  channels:read  users:read  channels:join
# Add Redirect URL in OAuth & Permissions:
#   Local:      http://localhost:8000/slack/oauth/callback
#   Production: https://your-domain.com/slack/oauth/callback
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# CSRF state signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SLACK_OAUTH_STATE_SECRET=your-64-char-hex-secret-here

# ── Google Drive OAuth ──────────────────────────────────────────────────────────────
# Create OAuth credentials at: https://console.cloud.google.com
#   APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web application)
#   Enable: Google Drive API
# Add Authorized redirect URI:
#   Local:      http://localhost:8000/gdrive/oauth/callback
#   Production: https://your-domain.com/gdrive/oauth/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Reuses SLACK_OAUTH_STATE_SECRET for CSRF if not set separately
# GOOGLE_OAUTH_STATE_SECRET=your-64-char-hex-secret-here

# ── Background Sync ───────────────────────────────────────────────────────────
# How often (in seconds) to re-sync all connected sources. Default: 1800 (30 min).
SYNC_INTERVAL_SECONDS=1800

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production, restrict to your actual frontend origin(s).
# Example: CORS_ORIGINS=https://kgf.yourcompany.com
# Leave as * only for local development.
CORS_ORIGINS=*

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Slack incoming webhook URL for uptime/error alerts.
# Create at: https://api.slack.com/messaging/webhooks
MONITORING_SLACK_WEBHOOK=

# ── GCP (production only — not needed for local dev) ──────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ── SMTP (Email Notifications) ────────────────────────────────────────────────
# SMTP server host and port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Authentication credentials.
SMTP_USERNAME=your-smtp-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
# The email address shown in the "From" header.
SMTP_SENDER=sutra@smriti.one

