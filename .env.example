# ─────────────────────────────────────────────────────────────────────────────
# Smriti — Internal Company ChatGPT
# Copy to .env and fill in. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Company ──────────────────────────────────────────────────────────────────
# The single company tenant. Every chunk is scoped to this UUID.
# Run a fresh install once: psql $DATABASE_URL -c "INSERT INTO public.tenant_registry
# (tenant_id, name) VALUES ('00000000-0000-0000-0000-000000000001', 'Internal')
# ON CONFLICT (tenant_id) DO NOTHING;"
COMPANY_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev:  docker compose up db   (or: supabase start)
# Production: your managed Postgres + pgvector endpoint.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Ollama (local inference) ─────────────────────────────────────────────────
# Pull these once:
#   ollama pull nomic-embed-text   # 274 MB — embeddings
#   ollama pull phi4-mini          # ~2.5 GB — generation
#   ollama pull llava:7b           # optional, for image description
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embeddings
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
SMRITI_EMBED_MODEL=nomic-embed-text
SMRITI_CHAT_MODEL=phi4-mini:latest
# Whisper model size: tiny | base | small | medium | large
# tiny = ~75 MB, runs on CPU. Upgrade to base/small when you have headroom.
SMRITI_WHISPER_MODEL=tiny

# ── Auth ─────────────────────────────────────────────────────────────────────
# SMRITI_DEV_MODE=true skips Supabase JWT validation. LOCAL DEV ONLY.
# In production set SMRITI_DEV_MODE=false and supply real Supabase keys.
SMRITI_DEV_MODE=true
SMRITI_ENV=local
SMRITI_DEV_USER_EMAIL=you@yourcompany.com

# Supabase project (production). Leave blank in dev mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── OIDC / SSO (on-prem production — Azure AD / Okta / Keycloak) ──────────────
# When set, Bearer JWTs are validated locally against your IdP's JWKS — no
# dependency on Supabase. RS256-only. Pin SMRITI_OIDC_JWKS_URL for air-gapped deploys.
# Self-check: SMRITI_DEV_MODE=true SMRITI_ENV=local python -m backend.auth
SMRITI_OIDC_ISSUER=
SMRITI_OIDC_AUDIENCE=
SMRITI_OIDC_JWKS_URL=

# ── RBAC (single-tenant) ─────────────────────────────────────────────────────
# Comma-separated admin email allowlist. Others = read-only viewer.
# Unset = legacy "first user is admin" (local dev only).
SMRITI_ADMINS=

# ── Audit log ────────────────────────────────────────────────────────────────
# Append-only NDJSON of every query. Point at a persistent volume / SIEM drop dir.
SMRITI_AUDIT_LOG_PATH=

# ── AWS / S3 ingestion ───────────────────────────────────────────────────────
# S3 bucket where users drop documents. S3 EventBridge → SQS → backend worker.
AWS_REGION=us-east-1
S3_BUCKET=acme-internal-docs
S3_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/smriti-ingest
# boto3 picks up credentials from the standard AWS chain:
#   - AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY env vars
#   - ~/.aws/credentials
#   - EC2/ECS instance role
# In production, prefer instance role — do not bake keys into the image.

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. In production, set explicitly. "*" is allowed only
# in local/dev.
CORS_ORIGINS=*
