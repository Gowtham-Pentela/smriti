# ── Streamlit UI Dockerfile ───────────────────────────────────────────────────
# Lightweight image — only Streamlit + requests needed for the UI process.

FROM python:3.12-slim

WORKDIR /app

# Install only UI dependencies (no asyncpg, no whisper, no slack-sdk)
RUN pip install --no-cache-dir \
    streamlit==1.35.0 \
    requests==2.32.3

COPY app.py .

# Streamlit configuration: disable the built-in file watcher in production
ENV STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ENABLE_CORS=false \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    # Backend API URL (overridden by K8s env to point at backend-api Service)
    BACKEND_URL="http://localhost:8000"

EXPOSE 8501

CMD ["streamlit", "run", "app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0", \
     "--server.headless", "true"]
